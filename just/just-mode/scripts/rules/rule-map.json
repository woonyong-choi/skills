  "select": [
    {
      "when": "모든 코드 파일",
      "suffixes": [
        ".py",
        ".js",
        ".mjs",
        ".cjs",
        ".jsx",
        ".ts",
        ".tsx",
        ".rs",
        ".kt",
        ".kts",
        ".css"
      ],
      "rules": [
        "principle-prove-it-works",
        "CS-CORE",
        "CS-VERIFY",
        "CS-LANGUAGE",
        "CS-TEST"
      ]
    },
    {
      "when": "로직이 있는 코드 파일",
      "suffixes": [
        ".py",
        ".js",
        ".mjs",
        ".cjs",
        ".jsx",
        ".ts",
        ".tsx",
        ".rs",
        ".kt",
        ".kts"
      ],
      "rules": [
        "principle-foundational-thinking",
        "principle-laziness-protocol"
      ]
    },
    {
      "when": "Python",
      "suffixes": [
        ".py"
      ],
      "rules": [
        "code-style-python"
      ]
    },
    {
      "when": "JavaScript(TypeScript 전용 절 제외)",
      "suffixes": [
        ".js",
        ".mjs",
        ".cjs",
        ".jsx"
      ],
      "rules": [
        "code-style-typescript-common"
      ]
    },
    {
      "when": "TypeScript",
      "suffixes": [
        ".ts",
        ".tsx"
      ],
      "rules": [
        "code-style-typescript",
        "principle-type-system-discipline",
        "principle-boundary-discipline"
      ]
    },
    {
      "when": "Rust",
      "suffixes": [
        ".rs"
      ],
      "rules": [
        "code-style-rust",
        "principle-type-system-discipline"
      ]
    },
    {
      "when": "Kotlin",
      "suffixes": [
        ".kt",
        ".kts"
      ],
      "rules": [
        "code-style-kotlin",
        "principle-type-system-discipline"
      ]
    },
    {
      "when": "CSS",
      "suffixes": [
        ".css"
      ],
      "rules": [
        "code-style-css",
        "CS-INTERFACES"
      ]
    },
    {
      "when": "화면 컴포넌트",
      "suffixes": [
        ".jsx",
        ".tsx"
      ],
      "rules": [
        "CS-INTERFACES",
        "principle-experience-first"
      ]
    },
    {
      "when": "테스트 파일",
      "suffixes": [
        ".py",
        ".js",
        ".mjs",
        ".cjs",
        ".jsx",
        ".ts",
        ".tsx",
        ".rs",
        ".kt",
        ".kts"
      ],
      "path": "(^|/)(tests?|__tests__|spec)/|(^|/)test_[^/]*\\.py$|_test\\.(py|rs|kt)$|\\.(test|spec)\\.[cm]?[jt]sx?$",
      "rules": [
        "principle-test-behavior-not-implementation",
        "principle-sequence-verifiable-units"
      ]
    },
    {
      "when": "함수·분기 정의",
      "suffixes": [
        ".py",
        ".js",
        ".mjs",
        ".cjs",
        ".jsx",
        ".ts",
        ".tsx",
        ".rs",
        ".kt",
        ".kts"
      ],
      "content": "\\b(?:def|class|fn|fun|function|if|for|while)\\b|=>",
      "rules": [
        "CS-SIZE"
      ]
    },
    {
      "when": "이름·선언 추가",
      "suffixes": [
        ".py",
        ".js",
        ".mjs",
        ".cjs",
        ".jsx",
        ".ts",
        ".tsx",
        ".rs",
        ".kt",
        ".kts"
      ],
      "content": "\\b(?:def|class|fn|fun|function|const|let|var|val|struct|enum|interface|type)\\b|=>",
      "rules": [
        "CS-NAME",
        "CS-ORDER"
      ]
    },
    {
      "when": "공개 범위·주석",
      "suffixes": [
        ".py",
        ".js",
        ".mjs",
        ".cjs",
        ".jsx",
        ".ts",
        ".tsx",
        ".rs",
        ".kt",
        ".kts"
      ],
      "content": "\\b(?:def|class|fn|fun|function|public|private|pub|export)\\b|#|//|=>",
      "rules": [
        "CS-VISIBILITY"
      ]
    },
    {
      "when": "조건식·분기",
      "suffixes": [
        ".py",
        ".js",
        ".mjs",
        ".cjs",
        ".jsx",
        ".ts",
        ".tsx",
        ".rs",
        ".kt",
        ".kts"
      ],
      "content": "\\b(?:if|elif|else|match|switch|when|for|while)\\b|\\?",
      "rules": [
        "CS-CONDITION"
      ]
    },
    {
      "when": "실패 가능한 입력·외부 경계·오류",
      "suffixes": [
        ".py",
        ".js",
        ".mjs",
        ".cjs",
        ".jsx",
        ".ts",
        ".tsx",
        ".rs",
        ".kt",
        ".kts"
      ],
      "content": "\\b(?:raise|try|except|throw|catch|Result|Error|open|fetch|parse|loads)\\b|read_|write_|subprocess|JSON\\.parse",
      "rules": [
        "CS-ERROR",
        "principle-boundary-discipline"
      ]
    },
    {
      "when": "동시성·공유 상태",
      "suffixes": [
        ".py",
        ".js",
        ".mjs",
        ".cjs",
        ".jsx",
        ".ts",
        ".tsx",
        ".rs",
        ".kt",
        ".kts"
      ],
      "content": "\\b(?:async|await|locked|Lock|RLock|Semaphore|Mutex|transaction|Thread|threading|multiprocessing|flock|Promise\\.all|spawn|tokio|coroutine|suspend)\\b",
      "rules": [
        "CS-DATA",
        "principle-separate-before-serializing-shared-state",
        "principle-make-operations-idempotent"
      ]
    },
    {
      "when": "프로세스·권한·환경·외부 실행",
      "suffixes": [
        ".py",
        ".js",
        ".mjs",
        ".cjs",
        ".jsx",
        ".ts",
        ".tsx",
        ".rs",
        ".kt",
        ".kts"
      ],
      "content": "\\b(?:permission|authorization|subprocess|exec_module|environ|Popen|child_process|process\\.env|token|secret)\\b",
      "rules": [
        "CS-OPERATIONS",
        "principle-boundary-discipline"
      ]
    },
    {
      "when": "상태·타입 모델",
      "suffixes": [
        ".py",
        ".js",
        ".mjs",
        ".cjs",
        ".jsx",
        ".ts",
        ".tsx",
        ".rs",
        ".kt",
        ".kts"
      ],
      "content": "\\b(?:class|struct|enum|interface|sealed|dataclass|TypedDict|NamedTuple|type\\s+\\w+\\s*=)",
      "rules": [
        "principle-model-the-domain"
      ]
    },
    {
      "when": "성능·캐시·큐",
      "suffixes": [
        ".py",
        ".js",
        ".mjs",
        ".cjs",
        ".jsx",
        ".ts",
        ".tsx",
        ".rs",
        ".kt",
        ".kts"
      ],
      "content": "\\b(?:cache|Cache|lru_cache|benchmark|perf_counter|timeit|Queue|queue|batch|pool)\\b",
      "rules": [
        "CS-RESOURCES",
        "principle-explain-the-number"
      ]
    }
  ]
}
